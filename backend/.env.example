# ============================================================
# director backend — 环境变量模板（2026-08-25，P3）
#
# 用法：cp .env.example .env && 填入密钥。backend/.env 已被 .gitignore 忽略。
# 所有变量均可选——未配置时对应 provider 自动降级/不可用，后端仍可启动。
# ============================================================

# ---------- 服务 ----------
DIRECTOR_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- ComfyUI（本地视频生成核心）----------
COMFYUI_HOST=
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=

# ---------- 文本 / LLM（剧本、分镜提示词）----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ---------- 图片 / 视频 provider（按需启用）----------
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=
ARK_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com
VOLCENGINE_TEXT_MODEL=doubao-seed-2-0-pro
VOLCENGINE_IMAGE_MODEL=doubao-seedream-4-5
VOLCENGINE_VIDEO_MODEL=doubao-seedance-1-0-pro-fast
JIMENG_CLI_PATH=jimeng
JIMENG_POLL_SECONDS=30
RUNNINGHUB_API_KEY=
RUNNINGHUB_WALLET_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.cn

# ---------- 工具链 ----------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
GEN_TASK_TIMEOUT=600
