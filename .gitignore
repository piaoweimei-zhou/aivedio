# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.venv-test/
venv/

# Node
node_modules/
dist/

# Env
.env
.env.local
.env.*.local

# Logs
*.log
backend/logs/
backend/output/**/pipeline_gen/*.log
backend/output/**/video_gen/*.log

# Editor state
.reasonix/
.idea/
.vscode/

# Data（运行时产物，不入库）
data/
backend/data/
backend/output/
backend/assets/
backend/static/director/comfyui_output/

# 历史中间产物归档（P3 治理约定）：output/ 与 data/ 下的 _archive_<日期>/ 目录，
# 用于集中存放历史中间产物/调试脚本/旧报告，移动优先、可逆、不入库；可随时删除释放空间
backend/output/_archive_*/
backend/data/_archive_*/

# Runtime input（运行时输入，不入库）
input/

# 临时导出报告
docs/qc-report-export-*/

# 工具残留
.codebuddy/
.trae-html-share-packages/

# ComfyUI 自定义节点（外部依赖）
custom_nodes/

# Archive
backend/_archive/

# Build
frontend-director/dist/

# 归档（数据备份不入库）
docs/99_归档/

# coverage
backend/.coverage
backend/htmlcov/
backend/coverage.xml

# 测试重定向输出
backend/*_out.txt

# 临时中间产物
backend/_*.txt
