#!/bin/sh
# director commit-msg hook（B 项：提交信息规范机器强制）
# 委托 pre-commit 框架执行 commit-msg 阶段（.pre-commit-config.yaml 中 commit-msg-conventional）
# 启用：git config core.hooksPath .githooks（本仓库已配置）
# 校验格式：type(scope): subject（feat/fix/docs/style/refactor/perf/test/build/ci/chore/revert）

cd "$(git rev-parse --show-toplevel)" || exit 1

if [ ! -f backend/.venv-test/Scripts/python.exe ]; then
  echo "commit-msg: backend/.venv-test 缺失，先安装依赖"
  exit 1
fi

exec "backend/.venv-test/Scripts/python.exe" -m pre_commit run --hook-stage commit-msg --commit-msg-filename "$1"
