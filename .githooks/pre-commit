#!/bin/sh
# director pre-commit hook（统一门禁前置，替代原手写 ratchet 钩子）
# 委托 pre-commit 框架执行 .pre-commit-config.yaml：
#   backend flake8 + trafficos flake8 + frontend eslint（三端 0-error）
# 启用：git config core.hooksPath .githooks（本仓库已配置）
# 全量验证：backend/.venv-test/Scripts/python.exe -m pre_commit run --all-files

cd "$(git rev-parse --show-toplevel)" || exit 1

if [ ! -f backend/.venv-test/Scripts/python.exe ]; then
  echo "pre-commit: backend/.venv-test 缺失，先安装依赖（详见 docs/工程化/开发流程SOP.md）"
  exit 1
fi

exec "backend/.venv-test/Scripts/python.exe" -m pre_commit run --hook-stage pre-commit
